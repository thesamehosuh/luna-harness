#!/usr/bin/env bash
# Resolve the installed launcher even through ~/.local/bin/luna and bind custom homes.
set -euo pipefail
LAUNCHER="${BASH_SOURCE[0]}"
while [[ -L "$LAUNCHER" ]]; do
  BASE="$(cd "$(dirname "$LAUNCHER")" && pwd)"
  LAUNCHER="$(readlink "$LAUNCHER")"
  [[ "$LAUNCHER" = /* ]] || LAUNCHER="$BASE/$LAUNCHER"
done
BASE="$(cd "$(dirname "$LAUNCHER")/.." && pwd)"
if [[ -f "$BASE/.luna-assemble-manifest.json" ]]; then
  DEFAULT_HOME="$BASE"
else
  DEFAULT_HOME="$HOME/.luna"
fi
export LUNA_HOME="${LUNA_HOME:-$DEFAULT_HOME}"
export HERMES_HOME="$LUNA_HOME"
CODE_ROOT="$BASE"
[[ ! -d "$BASE/current" ]] || CODE_ROOT="$BASE/current"
export PYTHONPATH="$CODE_ROOT/luna/lib:$CODE_ROOT"
if [[ -x "$BASE/venv/bin/python" ]]; then
  exec "$BASE/venv/bin/python" -m luna_cli.main "$@"
fi
if [[ -x "$LUNA_HOME/venv/bin/python" ]]; then
  exec "$LUNA_HOME/venv/bin/python" -m luna_cli.main "$@"
fi
# Explicit development interpreter only; never silently use the old working deployment.
if [[ -n "${HERMES_PY:-}" && -x "$HERMES_PY" ]]; then
  REPO_ROOT="$(cd "$BASE/.." && pwd)"
  exec env PYTHONPATH="$REPO_ROOT/luna/lib:$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}" \
    "$HERMES_PY" -m luna_cli.main "$@"
fi
echo "luna: runtime missing. Run install.sh first (home: $LUNA_HOME)." >&2
exit 127
