{
  "_comment": "Template. install.sh renders this to $HERMES_HOME/honcho.json. The userPeerAliases map is regenerated by the People page's Sync button from the luna_identity registry (every member gets a stable named peer); the value below is only the seed.",
  "hosts": {
    "hermes": {
      "peerName": "operator",
      "aiPeer": "luna",
      "workspace": "luna",
      "observationMode": "directional",
      "writeFrequency": "async",
      "recallMode": "hybrid",
      "dialecticCadence": 8,
      "dialecticReasoningLevel": "medium",
      "sessionStrategy": "per-session",
      "enabled": true,
      "saveMessages": true,
      "pinUserPeer": false,
      "userPeerAliases": {},
      "runtimePeerPrefix": "telegram_",
      "dialecticDepth": 1,
      "firstTurnDialecticWait": 0
    }
  },
  "baseUrl": "http://localhost:8000",
  "timeout": 90,
  "dialecticCadence": 8
}
